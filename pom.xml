<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.oatelauser</groupId>
    <artifactId>promql-java</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>promql-java</name>
    <description>PromQL 语法层与 Prometheus API 客户端的聚合父模块。
        promql-core：PromQL 字符串 ⇄ AST（移植自 Prometheus 官方 Go 实现语法层，零依赖）；
        prometheus-api：对接 Prometheus HTTP API 响应的客户端（仅依赖 promql-core 与 Gson）。</description>
    <url>https://github.com/Oatelauser/promql-java</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>oatelauser</id>
            <name>oatelauser</name>
            <url>https://github.com/Oatelauser</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Oatelauser/promql-java.git</connection>
        <developerConnection>scm:git:git@github.com:Oatelauser/promql-java.git</developerConnection>
        <url>https://github.com/Oatelauser/promql-java</url>
    </scm>

    <modules>
        <module>promql-core</module>
        <module>prometheus-api</module>
        <module>promql-bench</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 语言下限 Java 17；工具链更高版本时以 release 17 编译 -->
        <maven.compiler.release>17</maven.compiler.release>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 模块间依赖 -->
            <dependency>
                <groupId>io.github.oatelauser</groupId>
                <artifactId>promql-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oatelauser</groupId>
                <artifactId>prometheus-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- prometheus-api 的唯一运行时第三方依赖（Q21 决定） -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration>
                        <!-- javadoc 以中文为主、含项目内写法约定（Q4=C 等），不做 doclint -->
                        <doclint>none</doclint>
                        <detectJavaApiLink>false</detectJavaApiLink>
                        <detectLinks>false</detectLinks>
                        <encoding>UTF-8</encoding>
                        <charset>UTF-8</charset>
                        <docencoding>UTF-8</docencoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- 发布 profile：随 release.yml（tag v*）触发，发布到 Maven Central
         （central.sonatype.com，Central Portal）。本地可 mvn -P release package 预演
         （sources/javadoc/gpg 签名构件生成，不上传）。
         promql-bench 经 central-publishing 的 excludeArtifacts 排除——
         maven.deploy.skip 对该插件无效（无 sources/javadoc 的模块混入 bundle
         会被 Central 校验整体拒绝）。流程与踩坑见 RELEASE.md。 -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 不发布的模块（按 artifactId 匹配） -->
                            <excludeArtifacts>
                                <artifactId>promql-bench</artifactId>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <distributionManagement>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>
